# Copy to .env and fill in. See docs/deploy.md.

# Where the SQLite database and photos live inside the container.
DATA_DIR=/data

# Timezone for "today", dates and the forecast.
TZ=Australia/Sydney

# Forecast location (decimal degrees). Default is Gosford, NSW Central Coast.
WEATHER_LAT=-33.43
WEATHER_LON=151.34

# Cloudflare Access. Both are required in production. Never expose the app
# without Access (or an equivalent) in front of it.
# Team domain: "myteam" or "myteam.cloudflareaccess.com".
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application.
CF_ACCESS_AUD=

# Local admin account (username + password). Everyone else signs in via Access.
ADMIN_USERNAME=nathaniel
# Either a plain password (hashed in memory at startup) or an argon2 hash.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Optional. If unset, a random secret is generated and stored in DATA_DIR.
SESSION_SECRET=

# Which user's wardrobe the MCP server acts on when called with a service token
# or the bearer token. If unset and there is exactly one Access user, that user.
MCP_USER_EMAIL=
# Fallback for MCP clients that cannot send Cloudflare service token headers.
# Leave empty to disable. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Public URL of the app, used to build photo URLs in MCP responses.
PUBLIC_BASE_URL=https://outfits.example.com

# Local development only. Bypasses Access and signs you in as a dev admin.
# Never set this in production.
DEV_MODE=false
